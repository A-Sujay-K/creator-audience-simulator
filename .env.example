# .env.example
# Copy this file to .env and fill in your values. NEVER commit .env to version control.

# ─── LLM Configuration (Groq Cloud) ──────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
MODEL_FAST=openai/gpt-oss-20b
MODEL_SMART=openai/gpt-oss-120b

# ─── Web Crawling & Search (Firecrawl API) ────────────────────────────────────
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# ─── Security & Cryptographic Sessions ────────────────────────────────────────
# Generate a strong 32-byte secret (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=your_random_32_byte_hex_session_secret_here

# Comma-separated list of allowed CORS origins (leave empty for default local origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# Server environment: 'development' or 'production' (disables debug reloader in production)
ENV=production

# ─── Cosmitude Bridge Integration ─────────────────────────────────────────────
BRIDGE_URL=https://ca.cosmitude.com/
BRIDGE_SERVER_ID=your_bridge_server_id_here
BRIDGE_MAC=Bridge-Web
BRIDGE_FORUM_ID=your_bridge_forum_id_here
BRIDGE_DEVICE_USER=@your_bridge_bot_username
BRIDGE_DEVICE_PW=your_bridge_device_password
BRIDGE_ADMIN_USER_ID=your_bridge_admin_user_id
